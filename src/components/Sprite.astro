---
import { spriteCss, spriteData, type SpriteName } from '~/lib/icons';

interface Props {
  name: SpriteName;
  /** rendered size in px of one *pixel* of the sprite */
  scale?: number;
  class?: string;
  /** give a label only if the sprite carries meaning on its own */
  label?: string;
}
const { name, scale = 2, class: cls = '', label } = Astro.props;
const { w, h, frames } = spriteData(name);
const prefix = `spr-${name}`;
---

<svg
  class:list={['inline-block shrink-0 align-[-0.15em]', cls]}
  width={w * scale}
  height={h * scale}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <style set:html={spriteCss(name, prefix)} />
  {
    frames.map((runs, f) => (
      <g class={`${prefix}-f${f}`}>
        {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.tone === 'ink' ? 'currentColor' : 'var(--straw)'} />)}
      </g>
    ))
  }
</svg>

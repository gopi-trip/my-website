---
import { nav, site } from '~/site.config';
import Pixel from './Pixel.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header role="banner" class="pt-8 sm:pt-12">
  <div class="flex items-start justify-between gap-4">
    <a href="/" class="group flex items-center gap-3 no-underline" aria-label={`${site.name}, home`}>
      <Pixel name="resident" scale={3} class="text-ink group-hover:text-accent" />
      <span class="leading-tight">
        <span class="pixel block text-lg sm:text-xl text-ink group-hover:text-accent">{site.name}</span>
        <span class="block text-xs text-ink-soft">{site.tagline}</span>
      </span>
    </a>
    <ThemeToggle />
  </div>

  <nav aria-label="primary" class="mt-6">
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      {
        nav.map((item) => {
          const current = isCurrent(item.href);
          return (
            <li class="relative">
              <a
                href={item.href}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'no-underline',
                  current ? 'text-ink' : 'text-ink-soft',
                ]}
              >
                {current && <span aria-hidden="true" class="absolute -left-[0.8em] text-accent">&gt;</span>}
                <span class:list={[current && 'underline decoration-2 underline-offset-4 decoration-accent']}>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <div class="dither mt-3" aria-hidden="true"></div>
</header>

---
import Base from '~/layouts/Base.astro';
import Pixel from '~/components/Pixel.astro';
---

<Base title="not found" noindex>
  <div class="mt-16 text-center">
    <Pixel name="seedling" scale={8} class="text-ink-soft" />
    <h1 class="pixel text-2xl mt-6">404 · nothing planted here</h1>
    <p class="mt-3 text-ink-soft max-w-[50ch] mx-auto">
      Either this page moved, or it's a note I linked to before writing it. Both happen more than I'd like.
    </p>
    <p class="mt-6 text-sm"><a href="/">go home</a> · <a href="/wiki/">browse the wiki</a> · <a href="/tags/">all tags</a></p>
  </div>
</Base>

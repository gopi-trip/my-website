---
import Base from '~/layouts/Base.astro';
import PageTitle from '~/components/PageTitle.astro';
import Stage from '~/components/Stage.astro';
import { getWiki, wikiCategory, wikiUpdated } from '~/lib/content';
import { isoDay } from '~/lib/format';

const notes = await getWiki();
const byCat = [...Map.groupBy(notes, wikiCategory)].sort(([a], [b]) => (a === 'misc' ? 1 : b === 'misc' ? -1 : a.localeCompare(b)));
---

<Base title="wiki" description="A growing collection of technical notes.">
  <PageTitle title="wiki" icon="sprout" intro="Notes I keep for myself and leave the door open on. They're never finished; each one is marked with how grown it is.">
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
      <Stage stage="seedling" /><Stage stage="budding" /><Stage stage="evergreen" />
    </p>
  </PageTitle>

  <div class="mb-8 no-print">
    <label for="wiki-q" class="label block mb-1">search notes</label>
    <input
      id="wiki-q"
      type="search"
      autocomplete="off"
      placeholder="type to filter… (press / to focus)"
      class="w-full bg-transparent border border-rule px-3 py-1.5 text-sm placeholder:text-ink-faint focus:border-ink focus:outline-none"
    />
    <p id="wiki-empty" class="mt-2 text-sm text-ink-soft" hidden>No note matches. Maybe it's one I should write.</p>
  </div>

  {
    byCat.map(([cat, list]) => (
      <section class="mb-8" data-wiki-group aria-label={cat}>
        <h2 class="pixel text-sm text-ink-faint mb-2">{cat}/ <span class="text-xs">({list.length})</span></h2>
        <ul>
          {list.map((n) => (
            <li class="py-1" data-wiki-item data-haystack={[n.data.title, n.data.description ?? '', ...n.data.tags, cat].join(' ').toLowerCase()}>
              <div class="flex items-baseline gap-2">
                <Stage stage={n.data.stage} short />
                <a href={`/wiki/${n.id}/`} class="min-w-0">{n.data.title}</a>
                <span class="leader hidden sm:block" aria-hidden="true" />
                <time datetime={wikiUpdated(n).toISOString()} class="hidden sm:inline text-xs text-ink-soft tabular-nums whitespace-nowrap">{isoDay(wikiUpdated(n))}</time>
              </div>
              {n.data.description && <p class="pl-[22px] text-xs text-ink-soft leading-snug">{n.data.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<script>
  const q = document.getElementById('wiki-q') as HTMLInputElement | null;
  const empty = document.getElementById('wiki-empty');
  const items = [...document.querySelectorAll<HTMLElement>('[data-wiki-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-wiki-group]')];
  const apply = () => {
    const terms = (q?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const it of items) {
      const ok = terms.every((t) => it.dataset.haystack!.includes(t));
      it.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) g.hidden = !g.querySelector('[data-wiki-item]:not([hidden])');
    if (empty) empty.hidden = shown > 0;
  };
  q?.addEventListener('input', apply);
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== q && !(e.target as HTMLElement).closest('input, textarea')) {
      e.preventDefault();
      q?.focus();
    }
  });
</script>

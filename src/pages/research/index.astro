---
import Base from '~/layouts/Base.astro';
import PageTitle from '~/components/PageTitle.astro';
import Section from '~/components/Section.astro';
import LinkList from '~/components/LinkList.astro';
import Status from '~/components/Status.astro';
import { getResearch } from '~/lib/content';
import { isoDay } from '~/lib/format';

const all = await getResearch();
const groups = [
  { kind: 'paper', title: 'papers', blurb: 'Written up, with or without a venue.' },
  { kind: 'experiment', title: 'experiments', blurb: 'Small, honest attempts. Negative results included.' },
  { kind: 'interest', title: 'open questions', blurb: 'Things I keep thinking about and would love to talk about.' },
] as const;
---

<Base title="research" description="Papers, experiments and research interests.">
  <PageTitle title="research" icon="flask" intro="Papers, experiments and the questions I'm circling. If one of these overlaps with your work, I'd genuinely like to hear from you." />

  {
    groups.map((g) => {
      const items = all.filter((r) => r.data.kind === g.kind);
      return (
        items.length > 0 && (
          <Section title={g.title} id={g.kind}>
            <p class="text-xs text-ink-faint -mt-1 mb-3">{g.blurb}</p>
            <ul class="space-y-5">
              {items.map((r) => (
                <li>
                  <a href={`/research/${r.id}/`} class="font-bold">{r.data.title}</a>
                  {r.data.authors.length > 0 && <p class="text-xs text-ink-soft">{r.data.authors.join(', ')}</p>}
                  <p class="text-sm text-ink-soft mt-0.5">{r.data.description}</p>
                  <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-faint">
                    <time datetime={r.data.date.toISOString()} class="tabular-nums">{isoDay(r.data.date)}</time>
                    {r.data.venue && <span class="italic">{r.data.venue}</span>}
                    <Status status={r.data.status} />
                    <LinkList links={r.data.links} />
                  </div>
                </li>
              ))}
            </ul>
          </Section>
        )
      );
    })
  }
</Base>

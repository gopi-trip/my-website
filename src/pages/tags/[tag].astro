---
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import PageTitle from '~/components/PageTitle.astro';
import EntryRow from '~/components/EntryRow.astro';
import { getTagIndex } from '~/lib/content';

export const getStaticPaths = (async () => {
  const index = await getTagIndex();
  return [...index].map(([tag, items]) => ({ params: { tag }, props: { items } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { items } = Astro.props;
---

<Base title={`#${tag}`} description={`Everything tagged ${tag}.`}>
  <PageTitle title={`#${tag}`} icon="tag" intro={`${items.length} ${items.length === 1 ? 'thing' : 'things'} filed under this.`} />
  <ul>
    {items.map((i) => <EntryRow href={i.href} title={i.title} date={i.date} aside={i.collection} />)}
  </ul>
  <p class="mt-8 text-xs"><a href="/tags/">&larr; all tags</a></p>
</Base>

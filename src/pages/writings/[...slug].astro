---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Article from '~/layouts/Article.astro';
import { getWritings } from '~/lib/content';
import { isoDay, readingTime } from '~/lib/format';

export const getStaticPaths = (async () => {
  const posts = await getWritings();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
---

<Article
  title={d.title}
  description={d.description}
  published={d.date}
  tags={d.tags}
  headings={headings}
  back={{ href: '/writings/', label: 'writings' }}
  prev={older && { href: `/writings/${older.id}/`, title: older.data.title }}
  next={newer && { href: `/writings/${newer.id}/`, title: newer.data.title }}
>
  <Fragment slot="meta">
    <time datetime={d.date.toISOString()}>{isoDay(d.date)}</time>
    {d.updated && <span>revised <time datetime={d.updated.toISOString()}>{isoDay(d.updated)}</time></span>}
    <span>{readingTime(post.body)} min read</span>
    <span>{d.kind}</span>
    {d.draft && <span class="mark">draft</span>}
  </Fragment>
  <Content />
</Article>
